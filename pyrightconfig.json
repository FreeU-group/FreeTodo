{
  "typeCheckingMode": "standard",
  "pythonVersion": "3.12",
  "venvPath": ".",
  "venv": ".venv",
  "include": ["server", "scripts"],
  "exclude": [
    "**/__pycache__",
    ".venv",
    ".venv/**",
    "build",
    "build/**",
    "dist",
    "dist/**",
    "server/data",
    "server/data/**",
    "server/migrations/versions"
  ],
  "reportMissingTypeStubs": "none"
}
