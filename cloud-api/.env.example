######## 环境 ########
ENV=dev

######## 认证 ########
AUTH_SECRET_KEY=change-me-to-a-strong-random-string
AUTH_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=60
AUTH_REFRESH_TOKEN_EXPIRE_DAYS=30
AUTH_IS_DEBUG=False
AUTH_DEBUG_CODE=888888

######## API 服务 ########
API_NAME=freeu-cloud-api
API_VERSION=0.1.0
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=True

######## PostgreSQL ########
POSTGRES_HOST=localhost
POSTGRES_PORT=15432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=123456
POSTGRES_DB=freeu
POSTGRES_ECHO=False
POSTGRES_POOL_SIZE=20
POSTGRES_MAX_OVERFLOW=30
POSTGRES_POOL_TIMEOUT=30
POSTGRES_POOL_RECYCLE=3600
POSTGRES_POOL_PRE_PING=True

######## Redis ########
REDIS_HOST=localhost
REDIS_PORT=16379
REDIS_USER=default
REDIS_PASSWORD=123456
REDIS_DB=0

######## MinIO ########
MINIO_ENDPOINT=localhost:19000
MINIO_ACCESS_KEY=root
MINIO_SECRET_KEY=12345678
MINIO_BUCKET_NAME=freeu
MINIO_SECURE=False

######## 推送通知 ########
FIREBASE_CREDENTIALS_PATH=
APNS_KEY_PATH=
APNS_KEY_ID=
APNS_TEAM_ID=

######## 短信 ########
SMS_PROVIDER=aliyun
SMS_ACCESS_KEY_ID=your-access-key-id
SMS_ACCESS_KEY_SECRET=your-access-key-secret
SMS_SIGN_NAME=your-sign-name
SMS_TEMPLATE_LOGIN=SMS_123456
SMS_TEMPLATE_REGISTER=SMS_123456
SMS_TEMPLATE_RESET=SMS_123456
