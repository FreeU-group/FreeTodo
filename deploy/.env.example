# Center backend port (host -> container)
CENTER_PORT=8001

# Frontend web port (host -> container)
WEB_PORT=3001

# API URL the browser uses to reach the backend
# For local development, use http://localhost:8001
NEXT_PUBLIC_API_URL=http://localhost:8001

# Sensor node ID (defaults to "docker-sensor")
SENSOR_NODE_ID=docker-sensor

# DASHSCOPE API key
DASHSCOPE_API_KEY=your-api-key
