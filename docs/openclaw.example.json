{
  "plugins": {
    "enabled": true,
    "allow": ["freetodo"],
    "entries": {
      "freetodo": {
        "enabled": true,
        "config": {
          "baseUrl": "http://127.0.0.1:8001",
          "apiKey": "",
          "apiKeyHeader": "X-API-Key"
        }
      }
    }
  },
  "tools": {
    "allow": [
      "todo_list",
      "todo_get",
      "todo_create",
      "todo_update",
      "memory_today",
      "memory_get_date",
      "memory_search",
      "memory_profile_get",
      "memory_profile_update",
      "memory_profile_consolidate",
      "memory_compress_day",
      "memory_link_day",
      "memory_compress_and_link"
    ]
  }
}
